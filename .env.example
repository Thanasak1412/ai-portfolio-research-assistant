# Safe local-development defaults only. Do not store production credentials here.
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
DATABASE_URL=postgres://portfolio:portfolio_local_only@localhost:5432/portfolio?sslmode=disable
TEST_DATABASE_URL=postgres://portfolio:portfolio_test_local_only@localhost:5433/portfolio_test?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT=5s
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
WORKER_HEARTBEAT_INTERVAL=30s
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

